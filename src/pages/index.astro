---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import ResearchRow from '../components/ResearchRow.astro';
import NoteRow from '../components/NoteRow.astro';
import { research } from '../data/research';
import { getVisibleNotes } from '../lib/notes';
import { cv } from '../data/cv';
const visibleNotes = await getVisibleNotes();
const publishedNotes = visibleNotes.filter(note => !note.data.draft);
const notes = (publishedNotes.length > 0 ? publishedNotes : visibleNotes).slice(0, 3);
// Biography uses the wording supplied by Lunji on October 5, 2026.
---
<BaseLayout>
  <main id="main-content" class="container" tabindex="-1">
    <section class="home-intro has-portrait" aria-labelledby="profile-name">
      <div class="intro-copy">
        <p class="eyebrow">UCLA · Applied Mathematics</p>
        <h1 id="profile-name" class="profile-name">Lunji Zhu</h1>
        <div class="bio">
          <p>I am a Ph.D. student in Applied Mathematics at <a href="https://www.math.ucla.edu/">UCLA</a>. I am working with Prof. <a href="https://www.math.ucla.edu/~bertozzi/">Andrea Bertozzi</a> on AI for Applied Differential Equations. I also work with Prof. <a href="https://math.ucla.edu/~mihai/index.html">Mihai Cucuringu</a> on topics on quantitative finance and with Prof. <a href="https://yifanc96.github.io/index.html">Yifan Chen</a> on ensemble sampling.</p>
          <p>Beyond my current work, I am interested in machine learning theory, reinforcement learning, and data-driven methods for the social sciences.</p>
        </div>
        <div class="contact-links"><a href="mailto:lunji@math.ucla.edu">Email</a><a href="https://github.com/lunjiLv2">GitHub</a>{cv.href && <a href={cv.href}>CV</a>}</div>
      </div>
      <figure class="profile-portrait"><Image src={portrait} alt="Lunji Zhu outdoors with a mountain and forest in the background" width={660} format="webp" quality={85} loading="eager" /></figure>
    </section>
    <section aria-labelledby="selected-research">
      <div class="section-heading"><h2 id="selected-research">Selected research</h2><a href="/research/">All research <span aria-hidden="true">↗</span></a></div>
      <div class="research-list">{research.map(item => <ResearchRow item={item} fullTitle />)}</div>
    </section>
    {notes.length > 0 && <section aria-labelledby="recent-notes">
      <div class="section-heading"><h2 id="recent-notes">Notes</h2><a href="/notes/">All notes <span aria-hidden="true">↗</span></a></div>
      <div class="note-list">{notes.map(note => <NoteRow note={note} headingLevel={3} />)}</div>
    </section>}
  </main>
</BaseLayout>
