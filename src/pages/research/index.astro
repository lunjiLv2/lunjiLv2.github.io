---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchRow from '../../components/ResearchRow.astro';
import ResearchFigure from '../../components/ResearchFigure.astro';
import { research } from '../../data/research';
---
<BaseLayout title="Research" description="Research projects, manuscripts and related resources by Lunji Zhu.">
  <main id="main-content" class="container" tabindex="-1">
    <header class="page-intro"><p class="eyebrow">Projects and papers</p><h1>Research</h1><p>Current projects and selected manuscripts.</p></header>
    <div class="research-list">
      {research.map(item => <ResearchRow item={item} fullTitle headingLevel={2} />)}
      <article class="research-item research-project">
        <ResearchFigure kind="ensemble" />
        <div class="research-copy">
          <p class="research-status">Ongoing</p>
          <h2 class="research-title">Ensemble Sampling (with <a href="https://yifanc96.github.io/index.html">Prof. Yifan Chen</a>)</h2>
          <p class="research-description">Develop and study sampling algorithms, focusing on their theoretical properties and computational performance.</p>
        </div>
      </article>
      <article class="research-item research-project">
        <ResearchFigure kind="differential-equations" />
        <div class="research-copy">
          <p class="research-status">Ongoing</p>
          <h2 class="research-title">AI for Applied Differential Equations (with <a href="https://www.math.ucla.edu/~bertozzi/">Prof. Andrea Bertozzi</a>)</h2>
          <p class="research-description">Boost mathematical research on differential equation problems arising in science and engineering using frontier artificial intelligence tools.</p>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .research-project .research-description { margin-bottom: 0; }
</style>
